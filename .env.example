DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

# Credentials for an approved Reddit OAuth application.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:personal-monitor-deal-watcher:v1.0 (by /u/YOUR_USERNAME)
# Optional: use an existing refresh token instead of application-only OAuth.
REDDIT_REFRESH_TOKEN=

SUBREDDIT=buildapcsales
POLL_INTERVAL_SECONDS=60
STATE_DB_PATH=./data/deals.sqlite3
MAX_POST_AGE_HOURS=24
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=
KEYWORD_MATCH_MODE=any
MONITOR_FLAIRS=Monitor,Monitors
LOG_LEVEL=INFO
